; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="L M superheroes"
config/version="1.1.1"
run/main_scene="res://scenes/main_menu.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Lm Superheroes"
config/features=PackedStringArray("4.5", "Forward Plus")
boot_splash/bg_color=Color(0.317647, 0.286275, 0.380392, 1)
boot_splash/image="res://assets/purple_cat(1).png"
config/icon="res://assets/lm logo new.png"
config/windows_native_icon="res://assets/LM_Superheroes_Icon.ico"

[audio]

general/text_to_speech=true

[autoload]

State="*res://State.gd"
save_manager="*res://scenes/scripts/save_manager.gd"
Cards="*res://scenes/scripts/Cards.gd"
lm_http="*res://scenes/scripts/http.gd"
Achivements="*res://achivements/Achivements.gd"
SupabaseAuth="*res://sign in/SupabaseAuth.gd"
SilentWolf="*res://addons/silent_wolf/SilentWolf.gd"

[display]

window/size/mode=4
window/size/initial_position_type=0
window/stretch/mode="viewport"
mouse_cursor/custom_image="res://assets/lm_cursor_new.png"
mouse_cursor/tooltip_position_offset=Vector2(100, 0)

[editor_plugins]

enabled=PackedStringArray("res://addons/gdmail/plugin.cfg", "res://addons/silent_wolf/plugin.cfg")

