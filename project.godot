; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="L M superheroes"
config/version="1.1.1"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
boot_splash/bg_color=Color(0.317647, 0.286275, 0.380392, 1)
boot_splash/image="res://assets/purple_cat(1).png"
config/icon="res://assets/lm logo new.png"
config/windows_native_icon="res://assets/LM_Superheroes_Icon.ico"

[autoload]

State="*res://State.gd"

[display]

window/size/mode=4
window/size/initial_position_type=0
mouse_cursor/custom_image="res://assets/cersor_lm.png"
mouse_cursor/tooltip_position_offset=Vector2(100, 0)

